# Database connection string
# Uncomment and configure ONE of the following:

# MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/electronic_sales_db

# PostgreSQL
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/electronic_sales_db

# SQLite (local file)
# DATABASE_URL=sqlite:///electronics.db

# Leave blank or unset to run in CSV demo mode (reads from the project CSV file)
DATABASE_URL=
